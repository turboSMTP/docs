{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "turboSMTP",
  "colors": {
    "primary": "#2440EB",
    "light": "#7A90FF",
    "dark": "#2440EB"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.svg"
  },
  "logo": {
    "light": "/images/logo-dark.svg",
    "dark": "/images/logo-white.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started Free",
      "href": "https://serversmtp.com/en/signup"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "get-started/free-trial",
              "get-started/smtp-configuration",
              "get-started/api-keys"
            ]
          },
          {
            "group": "Sending Email",
            "icon": "paper-plane",
            "pages": [
              "sending/smtp-relay",
              "sending/email-api",
              "sending/code-examples",
              "sending/attachments"
            ]
          },
          {
            "group": "Deliverability",
            "icon": "shield-check",
            "pages": [
              "deliverability/spf-dkim-dmarc",
              "deliverability/custom-tracking-domain",
              "deliverability/smart-routing",
              "deliverability/bounce-spam-management"
            ]
          },
          {
            "group": "Analytics & Tracking",
            "icon": "chart-line",
            "pages": [
              "analytics/email-tracking",
              "analytics/statistics-dashboard",
              "analytics/webhooks"
            ]
          },
          {
            "group": "Account Management",
            "icon": "user-gear",
            "pages": [
              "account/subaccounts",
              "account/email-validation",
              "account/email-settings",
              "account/security",
              "account/plans-billing"
            ]
          },
          {
            "group": "Troubleshooting",
            "icon": "life-ring",
            "pages": [
              "troubleshooting/faq",
              "troubleshooting/common-errors",
              "troubleshooting/spam-folder"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "menu": [
          {
            "item": "Overview",
            "icon": "compass",
            "description": "Start here: all integrations, comparisons, and migration guides",
            "pages": [
              "guides/overview"
            ]
          },
          {
            "item": "Integrations",
            "icon": "plug",
            "description": "Frameworks, libraries, and apps that work with turboSMTP",
            "groups": [
              {
                "group": "Overview",
                "icon": "table-cells-large",
                "pages": [
                  "integrations/overview",
                  "integrations/sdks"
                ]
              },
              {
                "group": "Frameworks & Libraries",
                "icon": "cubes",
                "pages": [
                  "integrations/symfony-mailer",
                  "integrations/nodemailer",
                  "integrations/swoosh"
                ]
              },
              {
                "group": "Apps & Platforms",
                "icon": "puzzle-piece",
                "pages": [
                  "integrations/uptime-kuma",
                  "integrations/wordpress",
                  "integrations/cms-platforms",
                  "integrations/email-clients"
                ]
              }
            ]
          },
          {
            "item": "Compare & Migrate",
            "icon": "right-left",
            "description": "turboSMTP vs other providers and step-by-step migration guides",
            "groups": [
              {
                "group": "Comparisons",
                "icon": "scale-balanced",
                "pages": [
                  "compare/overview",
                  "compare/turbosmtp-vs-sendgrid",
                  "compare/turbosmtp-vs-mailgun"
                ]
              },
              {
                "group": "Migration Guides",
                "icon": "route",
                "pages": [
                  "migrate/from-sendgrid",
                  "migrate/from-mailgun"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/base-urls"
            ]
          },
          {
            "group": "Endpoints",
            "icon": "code",
            "pages": [
              "api-reference/send-email",
              "api-reference/suppressions",
              "api-reference/analytics",
              "api-reference/email-validation",
              "api-reference/subaccounts",
              "api-reference/alerts",
              "api-reference/consumer-keys"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "turbo-smtp.yaml",
    "examples": {
      "prefill": true
    }
  },
  "redirects": [
    {
      "source": "/account/integrations",
      "destination": "/integrations/overview",
      "permanent": true
    }
  ],
  "description": "turboSMTP developer docs: send transactional and marketing email via SMTP relay or Email API. Italian provider with EU servers and GDPR compliance.",
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#080B14"
    }
  },
  "footer": {
    "socials": {
      "facebook": "https://facebook.com/turboSMTP",
      "x": "https://x.com/turboSMTP",
      "youtube": "https://youtube.com/turboSMTP"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "contextual": {
    "options": [
      "assistant",
      "copy"
    ],
    "display": "header"
  },
  "seo": {
    "indexing": "navigable"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  }
}
